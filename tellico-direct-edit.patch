+void EntryEditDialog::setEmbeddedMode(bool embedded_) {
+  if(m_embeddedMode == embedded_) {
+    return;
+  }
+  m_embeddedMode = embedded_;
+  if(m_embeddedMode) {
+    setWindowFlags(Qt::Widget);
+    m_buttonBox->hide();
+    setSizePolicy(QSizePolicy::Expanding, QSizePolicy::Expanding);
+    connect(qApp, &QApplication::focusChanged,
+            this, &EntryEditDialog::slotFocusChanged,
+            Qt::UniqueConnection);
+  } else {
+    disconnect(qApp, &QApplication::focusChanged,
+               this, &EntryEditDialog::slotFocusChanged);
+    m_buttonBox->show();
+  }
+}
+
+void EntryEditDialog::slotFocusChanged(QWidget* old_, QWidget* now_) {
+  if(!m_embeddedMode || !m_modified || !old_ || !isAncestorOf(old_)) {
+    return;
+  }
+  if(!now_ || !isAncestorOf(now_)) {
+    slotHandleSave();
+  }
+}
+
 void EntryEditDialog::reject() {
   slotClose();
 }
